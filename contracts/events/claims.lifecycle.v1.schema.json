{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icmp.example/contracts/events/claims.lifecycle.v1.schema.json",
  "title": "ClaimLifecycleEvent v1",
  "description": "Published by claims-service on topic claims.lifecycle.v1 (key = claimId) for every claim state change. Consumers must ignore unknown fields (tolerant reader) and de-duplicate by eventId (delivery is at-least-once). A breaking change is published on a new topic (claims.lifecycle.v2).",
  "type": "object",
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "claimId", "claimNumber", "policyNumber",
               "claimantId", "market", "currency", "status", "actorId", "data"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid", "description": "Unique per event; the idempotency key." },
    "eventType": {
      "type": "string",
      "enum": ["ClaimSubmitted", "ClaimAssigned", "InfoRequested", "InfoProvided", "ClaimAssessed",
               "ClaimApproved", "ClaimSettled", "ClaimRejected", "ClaimWithdrawn"]
    },
    "schemaVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "claimId": { "type": "string", "format": "uuid" },
    "claimNumber": { "type": "string", "pattern": "^CLM-[A-Z]{2}-[0-9]{4}-[0-9]{6}$" },
    "policyNumber": { "type": "string" },
    "claimantId": { "type": "string", "format": "uuid" },
    "assignedOfficerId": { "type": ["string", "null"], "format": "uuid" },
    "assignedOfficerName": { "type": ["string", "null"] },
    "market": { "enum": ["SG", "HK", "AU", "MY", "TH", "ID"] },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "status": {
      "description": "Claim status after the change.",
      "enum": ["SUBMITTED", "UNDER_REVIEW", "INFO_REQUESTED", "ASSESSED", "APPROVED", "SETTLED", "REJECTED", "WITHDRAWN"]
    },
    "actorId": { "type": "string", "format": "uuid", "description": "User who caused the change." },
    "data": { "type": "object", "description": "Event-specific fields, see $defs." }
  },
  "allOf": [
    { "if": { "properties": { "eventType": { "const": "ClaimSubmitted" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/ClaimSubmitted" } } } },
    { "if": { "properties": { "eventType": { "const": "ClaimAssigned" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/ClaimAssigned" } } } },
    { "if": { "properties": { "eventType": { "const": "InfoRequested" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/InfoRequested" } } } },
    { "if": { "properties": { "eventType": { "const": "InfoProvided" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/InfoProvided" } } } },
    { "if": { "properties": { "eventType": { "const": "ClaimAssessed" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/ClaimAssessed" } } } },
    { "if": { "properties": { "eventType": { "const": "ClaimApproved" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/ClaimApproved" } } } },
    { "if": { "properties": { "eventType": { "const": "ClaimSettled" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/ClaimSettled" } } } },
    { "if": { "properties": { "eventType": { "const": "ClaimRejected" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/ClaimRejected" } } } }
  ],
  "$defs": {
    "ClaimSubmitted": { "type": "object", "required": ["claimType", "estimatedLoss", "priority"],
      "properties": { "claimantName": { "type": "string" }, "claimType": { "enum": ["MOTOR", "PROPERTY"] },
        "estimatedLoss": { "type": "number" }, "priority": { "enum": ["LOW", "MEDIUM", "HIGH"] } } },
    "ClaimAssigned": { "type": "object", "required": ["officerId", "officerName", "reassigned"],
      "properties": { "officerId": { "type": "string", "format": "uuid" }, "officerName": { "type": "string" },
        "reassigned": { "type": "boolean" } } },
    "InfoRequested": { "type": "object", "required": ["requestId", "question"],
      "properties": { "requestId": { "type": "string", "format": "uuid" }, "question": { "type": "string" } } },
    "InfoProvided": { "type": "object", "required": ["requestId"],
      "properties": { "requestId": { "type": "string", "format": "uuid" },
        "remainingOpenRequests": { "type": "integer" } } },
    "ClaimAssessed": { "type": "object", "required": ["liability", "recommendedAmount", "reserveAmount"],
      "properties": { "liability": { "enum": ["ACCEPTED", "PARTIAL", "DENIED"] },
        "recommendedAmount": { "type": "number" }, "reserveAmount": { "type": "number" },
        "reassessment": { "type": "boolean" } } },
    "ClaimApproved": { "type": "object", "required": ["amount"], "properties": { "amount": { "type": "number" } } },
    "ClaimSettled": { "type": "object", "required": ["amount", "paymentReference"],
      "properties": { "amount": { "type": "number" }, "paymentReference": { "type": "string" } } },
    "ClaimRejected": { "type": "object", "required": ["reasonCode", "explanation"],
      "properties": { "reasonCode": { "type": "string" }, "reasonDescription": { "type": "string" },
        "explanation": { "type": "string" } } }
  }
}
