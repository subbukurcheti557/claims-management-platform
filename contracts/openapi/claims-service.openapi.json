    "/api/claims/queue": {
      "get": {
        "tags": [
          "Claims - staff"
        ],
        "summary": "Work queue: UNASSIGNED (pick-up), MINE, TEAM (all open) or ALL, with filters",
        "operationId": "queue",
        "parameters": [
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "UNASSIGNED",
                "MINE",
                "TEAM",
                "ALL"
              ],
              "default": "UNASSIGNED"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "SUBMITTED",
                "UNDER_REVIEW",
                "INFO_REQUESTED",
                "ASSESSED",
                "APPROVED",
                "SETTLED",
                "REJECTED",
                "WITHDRAWN"
              ]
            }
          },
          {
            "name": "market",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "SG",
                "HK",
                "AU",
                "MY",
                "TH",
                "ID"
              ]
            }
          },
          {
            "name": "priority",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "LOW",
                "MEDIUM",
                "HIGH"
              ]
            }
          },
          {
            "name": "claimType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "MOTOR",
                "PROPERTY"
              ]
            }
          },
          {
            "name": "overdueOnly",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pageable",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Pageable"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageViewClaimSummary"
                }
              }
            }
          }
        }
      }
    },
