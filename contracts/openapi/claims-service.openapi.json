            "schema": {
              "type": "string",
              "enum": [
                "SG",
                "HK",
                "AU",
                "MY",
                "TH",
                "ID"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
