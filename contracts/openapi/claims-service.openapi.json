  "components": {
    "schemas": {
      "SubmitClaimRequest": {
        "required": [
          "claimType",
          "description",
          "estimatedLoss",
          "incidentDate",
          "incidentLocation",
          "policyNumber"
        ],
        "type": "object",
        "properties": {
          "policyNumber": {
            "maxLength": 30,
            "minLength": 0,
            "type": "string"
          },
          "claimType": {
            "type": "string",
            "enum": [
              "MOTOR",
              "PROPERTY"
            ]
          },
          "incidentDate": {
            "type": "string",
            "format": "date"
          },
          "incidentLocation": {
            "maxLength": 300,
            "minLength": 0,
            "type": "string"
          },
          "description": {
            "maxLength": 4000,
            "minLength": 20,
            "type": "string"
          },
          "injuryReported": {
            "type": "boolean"
          },
          "estimatedLoss": {
            "minimum": 0.01,
            "exclusiveMinimum": false,
            "type": "number"
          }
        }
      },
      "AssessmentView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "liability": {
            "type": "string"
          },
          "recommendedAmount": {
            "type": "number"
          },
          "reserveAmount": {
            "type": "number"
          },
          "findings": {
            "type": "string"
          },
          "assessorName": {
            "type": "string"
          },
          "assessedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ClaimDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "claimNumber": {
            "type": "string"
          },
          "policyNumber": {
            "type": "string"
          },
          "claimType": {
            "type": "string"
          },
          "market": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "allowedActions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "incidentDate": {
            "type": "string",
            "format": "date"
          },
          "incidentLocation": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "injuryReported": {
            "type": "boolean"
          },
          "estimatedLoss": {
            "type": "number"
          },
          "insuredItem": {
            "type": "string"
          },
          "assignedOfficerName": {
            "type": "string"
          },
          "approvedAmount": {
            "type": "number"
          },
          "paidAmount": {
            "type": "number"
          },
          "paymentReference": {
            "type": "string"
          },
          "rejectionReasonCode": {
            "type": "string"
          },
          "rejectionReason": {
            "type": "string"
          },
          "decisionNote": {
            "type": "string"
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "closedAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          },
          "infoRequests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InfoRequestView"
            }
          },
          "claimantId": {
            "type": "string",
            "format": "uuid"
          },
          "claimantName": {
            "type": "string"
          },
          "assignedOfficerId": {
            "type": "string",
            "format": "uuid"
          },
          "priority": {
            "type": "string"
          },
          "slaDueAt": {
            "type": "string",
            "format": "date-time"
          },
          "overdue": {
            "type": "boolean"
          },
          "reserveAmount": {
            "type": "number"
          },
          "sumInsured": {
            "type": "number"
          },
          "deductible": {
            "type": "number"
          },
          "maxPayable": {
            "type": "number"
          },
          "estimatedLossUsd": {
            "type": "number"
          },
          "latestAssessment": {
            "$ref": "#/components/schemas/AssessmentView"
          },
          "assessments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssessmentView"
            }
          },
          "noteCount": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "InfoRequestView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "question": {
            "type": "string"
          },
          "response": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "requestedByName": {
            "type": "string"
          },
          "requestedAt": {
            "type": "string",
            "format": "date-time"
          },
          "respondedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "WithdrawRequest": {
        "type": "object",
        "properties": {
          "reason": {
            "maxLength": 1000,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "SettleRequest": {
        "required": [
          "paymentReference"
        ],
        "type": "object",
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "format": "int64"
          },
          "paymentReference": {
            "maxLength": 60,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "RejectRequest": {
        "required": [
          "explanation",
          "reasonCode"
        ],
        "type": "object",
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "format": "int64"
          },
          "reasonCode": {
            "type": "string",
            "enum": [
              "NOT_COVERED",
              "POLICY_EXCLUSION",
              "INSUFFICIENT_EVIDENCE",
              "LATE_NOTIFICATION",
              "FRAUD_SUSPECTED",
              "OTHER"
            ]
          },
          "explanation": {
            "maxLength": 2000,
            "minLength": 10,
            "type": "string"
          }
        }
      },
      "NoteRequest": {
        "required": [
          "body"
        ],
        "type": "object",
        "properties": {
          "body": {
            "maxLength": 4000,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "NoteView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "body": {
            "type": "string"
          },
          "authorName": {
            "type": "string"
          },
          "authorId": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
